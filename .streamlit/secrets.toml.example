# Copie este arquivo para .streamlit/secrets.toml (não versionado)
# Preencha com o ID real do seu projeto Google Cloud.
[bigquery]
project_id = "SEU-PROJETO-REAL"
dataset = "controle_recebimento"
location = "southamerica-east1"

# Se estiver rodando localmente com credenciais padrão do gcloud
# (gcloud auth application-default login), não precisa desta seção.
# Para Streamlit Community Cloud, configure em Secrets com os valores
# exatos do JSON da conta de serviço (NÃO envie a chave pelo chat).
# [gcp_service_account]
# type = "service_account"
# project_id = "SEU-PROJETO-REAL"
# private_key_id = "..."
# private_key = """-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# """
# client_email = "conta-de-leitura@SEU-PROJETO-REAL.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
